{
  "name": "electron-starter",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "description": "An Electron application with React and TypeScript",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "bump": "bumpp -y -q",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@orpc/client": "2.0.0-beta.35",
    "@orpc/publisher": "2.0.0-beta.35",
    "@orpc/server": "2.0.0-beta.35",
    "@orpc/tanstack-query": "2.0.0-beta.35",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-conf": "^1.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.44.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "bumpp": "^12.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "lefthook": "^2.1.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  }
}
